{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aero Tandem Studio",
  "version": "0.1.24",
  "identifier": "com.kowalenko.aero-tandem-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aero Tandem Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ffmpeg/",
      "resources/assets/"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2MDAyRTREQzUxNkJEN0MKUldSOHZSYkZUUzRBbGx6enAwVm1zbEwxVjJzMnlRQ25XTDZRczJ2aFllc2hOWnB0aHFVcGU1eEEK",
      "endpoints": [
        "https://github.com/a-kowalenko/aero-tandem-studio-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
