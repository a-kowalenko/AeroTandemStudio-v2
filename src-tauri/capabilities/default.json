{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "**" }
      ]
    },
    "dialog:default",
    "updater:default",
    "process:default"
  ]
}
